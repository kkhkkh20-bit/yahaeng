; Godot 4.6 project. Import and run scenes/main.tscn.
config_version=5

[application]
config/name="야행 · VIP"
config/version="godot-vip-1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="VIP comparison slice — original Yahaeng resources, native Godot gameplay."

[display]
window/size/viewport_width=1200
window/size/viewport_height=800
window/size/window_width_override=1200
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0235, 0.0314, 0.051, 1)

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false
